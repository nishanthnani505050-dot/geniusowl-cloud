# ---- shared ----
OPENAI_API_KEY=sk-...
JOBAGENT_MODEL=gpt-4o-mini
JOBAGENT_DB=/data/jobagent.db          # put this on a persistent volume
JOBAGENT_ADMIN_TOKEN=long-random-string  # protects /jobagent/resume and /jobagent/run

# ---- WhatsApp Cloud API (Meta) ----
WHATSAPP_TOKEN=EAA...                  # permanent system-user token
WHATSAPP_PHONE_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=pick-any-string  # echoed back during webhook setup
WHATSAPP_APP_SECRET=...                # required: verifies inbound webhooks
WHATSAPP_DIGEST_TEMPLATE=geniusowl_daily_jobs
WHATSAPP_TEMPLATE_LANG=en

# ---- job sources (set at least one) ----
JOBAGENT_SOURCES=greenhouse,lever,adzuna,feed   # leave unset to use all available
JOBAGENT_GREENHOUSE_BOARDS=razorpay,zomato      # greenhouse board slugs
JOBAGENT_LEVER_BOARDS=swiggy                    # lever board slugs
JOBAGENT_ADZUNA_APP_ID=...                      # developer.adzuna.com
JOBAGENT_ADZUNA_APP_KEY=...
JOBAGENT_ADZUNA_COUNTRY=in
JOBAGENT_FEEDS=https://remotive.com/api/remote-jobs
JOBAGENT_MAX_DAYS_OLD=3
JOBAGENT_DIGEST_SIZE=10

# ---- optional: automatic email applications ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=apply@geniusowl.in
SMTP_PASSWORD=...
SMTP_FROM=apply@geniusowl.in
